# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
# Local MongoDB (MongoDB Compass / mongod):
MONGO_URI=mongodb://127.0.0.1:27017/luxurystay_hms
# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/luxurystay_hms

# ---------- Auth ----------
# Change this to a long random string before deploying
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---------- Frontend ----------
CLIENT_URL=http://localhost:5173

# ---------- Cloudinary (image uploads) ----------
# Free account: https://cloudinary.com → Dashboard → "API Keys"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (SMTP) ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your@gmail.com,
#        SMTP_PASS=16-character App Password (Google Account → Security → 2-Step Verification → App passwords)
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER/SMTP_PASS from Brevo → SMTP & API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown to guests, e.g. "LuxuryStay Hospitality" <no-reply@yourdomain.com>
EMAIL_FROM=

# ---------- Seeding ----------
# Password given to every account created by `npm run seed`
SEED_PASSWORD=LuxuryStay@2026
